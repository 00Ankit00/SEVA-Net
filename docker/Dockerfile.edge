# Edge node container - stands in for a physical edge device (PRD 7.1).
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        iperf3 iputils-ping ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY seva/ ./seva/
COPY scripts/ ./scripts/
COPY config.yaml run_demo.py ./

ENV PYTHONUNBUFFERED=1
CMD ["python", "scripts/run_trial.py", "--duration", "180", "--tag", "docker"]
